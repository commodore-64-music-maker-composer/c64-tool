<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry>
      <ID>600</ID>
      <Description>"FF9 Steam — God Mode (Djidane inclus, équipe entière)"</Description>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>// Uses the HP hook from the supplied Final Fantasy IX.ct.
// Original table credit: mul0 / mul0.com.
[ENABLE]
alloc(newmem,2048,BattleHUD:CheckHPState+b)
label(returnhere)
label(originalcode)

newmem:
    push rbx
    push rcx
    cmp qword ptr [rsi+28],00
    je originalcode
    cmp qword ptr [rsi+30],00
    je originalcode
    mov rbx,[rsi+28]
    mov rcx,[rsi+30]
    mov dx,[rbx+10]
    mov [rcx+10],dx

originalcode:
    pop rcx
    pop rbx
    mov rax,[rsi+30]
    movzx eax,word ptr [rax+10]
    jmp returnhere

BattleHUD:CheckHPState+b:
    jmp newmem
    nop
    nop
    nop

returnhere:

[DISABLE]
dealloc(newmem)

BattleHUD:CheckHPState+b:
    mov rax,[rsi+30]
    movzx eax,word ptr [rax+10]
</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols/>
</CheatTable>